---
// The GitHub action's landing page, the one its repository and Marketplace
// listing link to. For a team that wants every push and pull request
// checked so the payload cannot come back after a cleanup. A landing page,
// not a document: no breadcrumb, a calm hero, three steps, four promises,
// one code block and a line of links to the docs, which carry the detail.
//
// No version numbers, release SHAs or polinrider versions on this page, so
// a release of the action never needs an edit here. The pinned workflow
// lives in the docs (/docs/action/setup/). Every fact is from the action's
// README and action.yml (the action/ submodule) and ADR-0062.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageFoot from '../components/PageFoot.astro';
import { Code } from 'astro:components';
import { abs } from '../schema';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = `${base}/docs/action`;
const url = abs(Astro.url.pathname);
const themes = { light: 'github-light-default', dark: 'github-dark-default' } as const;

const MARKETPLACE = 'https://github.com/marketplace/actions/polinrider-scanner';
const REPOSITORY = 'https://github.com/meSingh/polinrider-action';

const workflow = `on: [push, pull_request]
permissions:
  contents: read
jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@<commit SHA>
        with:
          persist-credentials: false
      - uses: meSingh/polinrider-action@<commit SHA>`;

const steps = [
  {
    title: 'Add one workflow file',
    text: 'Pin it to a commit and let Dependabot keep it current.',
  },
  {
    title: 'It checks every push',
    text: 'Every push, every pull request and once a week. A confirmed finding fails the check, so it cannot merge.',
  },
  {
    title: 'Fix mode opens a pull request',
    text: 'If you turn it on, it removes the payload and opens a pull request for you to review.',
  },
];

const promises = [
  { icon: 'scan', title: 'The same scanner as your laptop', text: 'It runs the released polinrider program and its indicators, so CI gives the verdict you get at your desk.' },
  { icon: 'signature', title: 'Pinned by hash', text: 'It checks the SHA-256 of what it downloads and refuses anything that does not match.' },
  { icon: 'repo', title: 'Never touches your branch', text: 'No commits to the branch it scanned, no force-push and no merge. Fixes arrive as pull requests.' },
  { icon: 'lock', title: 'Read-only by default', text: 'Checking needs read access only, and the scan never sees a token.' },
] as const;

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    url,
    name: 'PolinRider Scanner GitHub action',
    about: { '@type': 'SoftwareSourceCode', name: 'PolinRider Scanner action', codeRepository: REPOSITORY, license: 'https://opensource.org/licenses/MIT' },
  },
];
---

<Base
  title="GitHub action"
  titleTag="PolinRider Scanner GitHub action: block PolinRider on every push"
  description="A free GitHub action that scans every push and pull request for PolinRider with the same scanner and indicators as the laptop tool, pinned by SHA-256."
  type="website"
  schema={schema}
>
  <section class="hero wrap">
    <h1>Stop PolinRider <span class="accent">coming back.</span></h1>
    <p class="tagline">
      A free GitHub action that checks every push and pull request with the same scanner you run on your laptop.
    </p>
    <div class="ctas">
      <a class="btn primary" href={MARKETPLACE}>Get it on the Marketplace</a>
      <a class="btn" href={`${d}/setup/`}>Read the docs <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <section class="wrap band" aria-labelledby="how-h">
    <h2 id="how-h" class="center">How it works</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap band" aria-labelledby="why-h">
    <h2 id="why-h" class="center">What makes it different</h2>
    <ul class="promises">
      {promises.map((p) => (
        <li>
          <span class="picon" aria-hidden="true"><Icon name={p.icon} size={20} /></span>
          <div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap band start" aria-labelledby="start-h">
    <div class="start-text">
      <h2 id="start-h">Add it in a minute</h2>
      <p>
        Save this as <code>.github/workflows/polinrider.yml</code>. Pin each action to a full commit SHA: the setup
        guide has the workflow with current SHAs, ready to copy.
      </p>
      <p>Then make <code>scan</code> a required check, so an infected change cannot merge.</p>
      <a class="textlink" href={`${d}/setup/`}>Copy the pinned workflow <Icon name="arrow" size={16} /></a>
    </div>
    <div class="snippet">
      <Code code={workflow} lang="yaml" themes={themes} defaultColor={false} />
    </div>
  </section>

  <section class="wrap details" aria-label="More about the action">
    <p>
      Runs on Linux and macOS runners. Trusts three things you can check yourself. Would rather fetch nothing at
      scan time? There is a copy you keep in your own repository.
    </p>
    <ul>
      <li><a href={`${d}/setup/#runners`}>Runners</a></li>
      <li><a href={`${d}/trust/`}>What it trusts</a></li>
      <li><a href={`${base}/docs/guides/ci/`}>The vendored copy</a></li>
      <li><a href={`${d}/fix-mode/`}>Fix mode</a></li>
      <li><a href={REPOSITORY}>Source on GitHub</a></li>
    </ul>
    <PageFoot file="src/pages/github-action.astro" />
  </section>
</Base>

<style>
  code {
    padding: 0.05em 0.35em;
    border: 1px solid var(--pr-border);
    border-radius: 6px;
    background: var(--pr-surface);
    color: var(--pr-heading);
    font-size: 0.88em;
    white-space: nowrap;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2rem);
    letter-spacing: -0.025em;
  }
  h3 {
    margin: 0;
    color: var(--pr-heading);
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .center {
    text-align: center;
  }
  .band {
    max-width: calc(64rem + 2 * var(--gutter));
    margin-top: clamp(4rem, 10vw, 7rem);
  }

  /* Hero: one headline, one line, two buttons and room around them. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(4.5rem, 13vw, 8.5rem) clamp(1rem, 3vw, 2rem);
    text-align: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: min(60rem, 120vw);
    height: 30rem;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at 50% 40%, var(--pr-glow), transparent 65%);
    pointer-events: none;
  }
  h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.5rem, 1.3rem + 4.6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .accent {
    color: var(--pr-accent);
  }
  .tagline {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--pr-text);
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.3125rem);
    line-height: 1.55;
    text-wrap: balance;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0.6rem 1.35rem;
    border: 1px solid var(--pr-border-strong);
    border-radius: 999px;
    background: var(--pr-bg);
    color: var(--pr-heading);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .btn:hover {
    border-color: var(--pr-heading);
    color: var(--pr-heading);
  }
  .btn.primary {
    border-color: var(--pr-pill-bg);
    background: var(--pr-pill-bg);
    color: var(--pr-pill-text);
  }
  .btn.primary:hover {
    color: var(--pr-pill-text);
    opacity: 0.88;
  }
  @media (max-width: 30rem) {
    .ctas {
      flex-direction: column;
      width: 100%;
    }
  }

  /* How it works: three steps in a row, joined by a hairline. */
  .steps {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
  .steps li {
    position: relative;
    text-align: center;
  }
  @media (min-width: 48rem) {
    .steps li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.25rem;
      left: calc(50% + 2rem);
      width: calc(100% + 2.5rem - 4rem);
      height: 1px;
      background: var(--pr-border-strong);
    }
  }
  .n {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border: 1px solid var(--pr-accent);
    border-radius: 50%;
    background: var(--pr-accent-bg);
    color: var(--pr-accent);
    font-weight: 700;
  }
  .steps p {
    max-width: 19rem;
    margin: 0.5rem auto 0;
    color: var(--pr-text);
    line-height: 1.6;
  }

  /* What makes it different: four promises, two by two. */
  .promises {
    display: grid;
    gap: 1px;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius);
    background: var(--pr-border);
    overflow: hidden;
  }
  @media (min-width: 44rem) {
    .promises {
      grid-template-columns: 1fr 1fr;
    }
  }
  .promises li {
    display: flex;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--pr-bg);
  }
  .picon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--pr-accent-bg);
    color: var(--pr-accent);
  }
  .promises p {
    margin: 0.35rem 0 0;
    color: var(--pr-text);
    line-height: 1.6;
  }

  /* Add it in a minute: the words beside one clean code block. */
  .start {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .start {
      grid-template-columns: 5fr 7fr;
      gap: 3rem;
    }
  }
  .start-text p {
    margin: 1rem 0 0;
    color: var(--pr-text);
    line-height: 1.65;
  }
  .start-text .textlink {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.25rem;
    font-weight: 600;
  }
  .snippet {
    min-width: 0;
  }
  .snippet :global(pre) {
    margin: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius);
    background: var(--pr-code-bg) !important;
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-x: auto;
  }
  @media (max-width: 30rem) {
    .snippet :global(pre) {
      padding: 1rem;
      font-size: 0.75rem;
    }
  }

  /* The details, as one quiet line of links to the docs. */
  .details {
    max-width: calc(64rem + 2 * var(--gutter));
    margin-top: clamp(4rem, 10vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--pr-border);
    text-align: center;
  }
  .details p {
    max-width: 40rem;
    margin: 0 auto;
    color: var(--pr-muted);
    line-height: 1.6;
  }
  .details ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
  .details :global(.page-foot) {
    text-align: start;
  }
</style>
